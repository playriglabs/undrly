# Local development only. Copy to `.env` and choose your own password.
# Never commit `.env` or real credentials.
UNDRLY_POSTGRES_PASSWORD=

# Enables the database tests in `undrly-store` (each test creates and drops
# its own `undrly_test_*` database, so the role needs CREATEDB).
# DATABASE_URL=postgres://undrly:<password>@127.0.0.1:5432/undrly

# Cross-market demo (docs/hackathon-v1.md). Optional.
# Alpaca market data (IEX feed) for the NVDA quote; without these the collector
# skips Alpaca. Sent as request headers only; never stored or logged.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# UNDRLY_USER_AGENT="Undrly/0.1 (+https://undrly.xyz)"
# UNDRLY_STALE_AFTER_SECONDS=300
# PORT=8787
