# Undrly API the dashboard reads from (server side only).
UNDRLY_API_URL=http://127.0.0.1:8787
# Sent as "Authorization: Bearer ..." once the API checks keys. Optional.
UNDRLY_API_KEY=

# Better Auth: accounts and sessions in the Undrly database (schema "dashboard").
DATABASE_URL=postgres://undrly:<password>@127.0.0.1:5432/undrly
# 32+ random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The dashboard's own origin (cookies are Secure when this is https). Locally,
# localhost and 127.0.0.1 are both accepted.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Other origins allowed to sign in, comma-separated (optional).
BETTER_AUTH_TRUSTED_ORIGINS=

# Billing through Mayarin subscriptions (https://docs.mayarin.xyz/guides/subscriptions).
# Testnet by default; a testnet key only works against the testnet API, so
# switch the URL and the key together. Mint the key at
# dashboard-testnet.mayarin.xyz with the `catalog:manage` and `payments:read`
# permissions, and set city and country in its settings.
MAYARIN_API_URL=https://api-testnet.mayarin.xyz
MAYARIN_SECRET_KEY=
# Signing secret of the webhook endpoint registered there:
# <BETTER_AUTH_URL>/api/webhooks/mayarin
MAYARIN_WEBHOOK_SECRET=

# Card billing through Polar, merchant of record (src/server/polar.ts).
# Sandbox by default (sandbox.polar.sh); set POLAR_SERVER=production with a
# production token. Create one monthly product per paid plan and paste their
# ids. Webhook endpoint to register: <BETTER_AUTH_URL>/api/auth/polar/webhooks
# (subscription.* events).
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_GROWTH=
